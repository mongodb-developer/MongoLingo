# MongoDB Atlas connection string (SRV).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name (optional, defaults to "mongolingo").
MONGODB_DB="mongolingo"

# Lock CORS to your GitHub Pages origin in production.
# Use "*" for local testing. Example production value:
# ALLOWED_ORIGIN="https://mongodb-developer.github.io"
ALLOWED_ORIGIN="*"
